# =============================================================================
# Mail Sender Service - Environment Configuration
# =============================================================================
# Copy to .env and configure for your environment
# =============================================================================

# =============================================================================
# Core Settings
# =============================================================================
# DEBUG controls multiple behaviors:
#   DEBUG=true  → environment=development, log_level=DEBUG
#   DEBUG=false → environment=production, log_level=INFO, security warnings active
DEBUG=false

# Override environment name if needed (optional, derived from DEBUG)
# ENVIRONMENT=staging

# Log format: json (production) or text (development)
LOG_FORMAT=json

# Optional: file logging (Docker volume)
# LOG_FILE=/app/logs/mailsender.log

# =============================================================================
# Application Metadata
# =============================================================================
PROJECT_NAME="Mail Sender API"
PROJECT_VERSION="1.0.0"
PROJECT_DESCRIPTION="API for automated email sending with multiple provider support"
API_PREFIX="/api/v1"

# =============================================================================
# Database (PostgreSQL) - REQUIRED
# =============================================================================
DB_HOST=localhost
DB_USER=mailsender_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_NAME=mailsender_db
# DB_PORT=5432  # Uncomment only if not using default

# =============================================================================
# Redis - REQUIRED
# =============================================================================
REDIS_HOST=localhost
# REDIS_PORT=6379      # Uncomment only if not using default
# REDIS_DB=0           # Uncomment only if not using default
# REDIS_PASSWORD=      # Uncomment if Redis requires auth

# =============================================================================
# Email Provider Selection - REQUIRED
# =============================================================================
# Options: smtp, sendgrid, mailchimp
EMAIL_PROVIDER=smtp

# =============================================================================
# SMTP Settings (if EMAIL_PROVIDER=smtp)
# =============================================================================
MAIL_HOST=localhost
MAIL_PORT=25
# MAIL_USERNAME=      # Uncomment if SMTP requires auth
# MAIL_PASSWORD=      # Uncomment if SMTP requires auth
MAIL_USE_TLS=false
MAIL_SENDER_EMAIL=no-reply@yourdomain.com

# =============================================================================
# SendGrid Settings (if EMAIL_PROVIDER=sendgrid)
# =============================================================================
# SENDGRID_API_KEY=       # Required if using SendGrid
# SENDGRID_FROM_EMAIL=    # Required if using SendGrid
SENDGRID_FROM_NAME="Mail Service"
SENDGRID_VERIFY_SSL=true
# SENDGRID_WEBHOOK_KEY=   # Optional — verifies signatures on /webhooks/sendgrid

# =============================================================================
# Mailchimp Settings (if EMAIL_PROVIDER=mailchimp)
# =============================================================================
# MAILCHIMP_API_KEY=      # Required if using Mailchimp
# MAILCHIMP_SERVER=       # e.g., us20
# MAILCHIMP_FROM_EMAIL=
MAILCHIMP_FROM_NAME="Mail Service"
# MAILCHIMP_LIST_ID=
# MAILCHIMP_WEBHOOK_KEY=  # Optional — verifies signatures on /webhooks/mailchimp

# =============================================================================
# Attachment Settings
# =============================================================================
MAX_ATTACHMENT_SIZE_MB=10.0
MAX_TOTAL_ATTACHMENTS_SIZE_MB=25.0
MAX_ATTACHMENTS_COUNT=10
# Allowed MIME types (comma-separated). See app/config.py for the default list.
# ALLOWED_ATTACHMENT_TYPES=application/pdf,text/plain,image/jpeg,image/png
# Storage path for attachments — must be pre-created with correct ownership in Docker
# ATTACHMENTS_STORAGE_PATH=/app/attachments
# Whether to persist attachments to disk (false = keep in-memory only)
# ATTACHMENTS_STORE_FILES=true

# =============================================================================
# Rate Limiting & Deduplication
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_EMAILS=100
RATE_LIMIT_WINDOW_SECONDS=3600
DEDUP_ENABLED=true
DEDUP_WINDOW_SECONDS=300

# =============================================================================
# Identity Service Integration - REQUIRED
# =============================================================================
# Base URL for identity service (server-to-server token validation).
# Development: http://localhost:8080/api/v1
# Docker (same host): http://host.docker.internal:8080/api/v1
# Production: http://identity-service:8080/api/v1
IDENTITY_SERVICE_URL=http://localhost:8080/api/v1

# Browser-reachable URL for the identity service — used by Swagger UI (tokenUrl)
# and the dashboard login page. Only needed when the container-internal URL
# above is not reachable from the browser (typical behind a reverse proxy).
# Example: https://your-domain.example.com/identity/api/v1
# IDENTITY_EXTERNAL_URL=

# =============================================================================
# CORS - REQUIRED for production
# =============================================================================
# Never use ["*"] in production!
CORS_ORIGINS=["https://your-frontend.com"]

# =============================================================================
# Advanced Settings - Docker Compose
# =============================================================================
# These are only used by docker-compose, not by the application directly

# External ports (to avoid conflicts when running multiple services)
# DB_PORT_EXTERNAL=5433
# REDIS_PORT_EXTERNAL=6380
# API_PORT=8081

# MailHog (development email testing)
# MAILHOG_SMTP_PORT=1025
# MAILHOG_WEB_PORT=8025
